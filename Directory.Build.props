<Project>
  <!--
    Shared build settings for every project in the repo (ProjectGraph contract).
    Project identity and kind come from build/ProjectKinds.g.props, generated from docs/project-graph.json.
    fsproj files hold file items (Compile, plus EmbeddedResource/None where needed) and nothing else.
  -->
  <PropertyGroup>
    <LrmRepoRoot>$([MSBuild]::EnsureTrailingSlash('$(MSBuildThisFileDirectory)').Replace('\', '/'))</LrmRepoRoot>
    <LrmProjectPath>$([MSBuild]::MakeRelative('$(LrmRepoRoot)', '$(MSBuildProjectFullPath)').Replace('\', '/'))</LrmProjectPath>
    <LrmIsSpike Condition="$(LrmProjectPath.StartsWith('spikes/'))">true</LrmIsSpike>
  </PropertyGroup>

  <!--
    Toolchain pins from tools/bootstrap/toolchain.json ($(LrmDxcExe) and friends), and project identity and kind.
    Toolchain.g.props also resolves $(LrmData) (DataRootAndToolchain): the LrmData property, else LRM_DATA, else
    $(LrmDefaultData), the dataRoot in toolchain.json. Nothing under it is ever committed.
  -->
  <Import Project="build/Toolchain.g.props" />
  <Import Project="build/ProjectKinds.g.props" />

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <!-- Struct layouts and the GPU stack assume 64-bit pointers; apps run as `dotnet <dll>`, x64 only. -->
    <PlatformTarget>x64</PlatformTarget>
    <UseAppHost>false</UseAppHost>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <Deterministic>true</Deterministic>
    <!--
      Reproducible output. CI=true (ContinuousIntegrationBuild) maps source and obj paths to /_/, so one commit builds
      to identical binaries in every clone whose path has the same length (CI, or nodes that build at a fixed path).
      F# 10.0.402 sizes the PE CodeView entry from the full, unmapped PDB path, so clones at other path lengths differ
      only in that zero padding; IL, metadata, resources and PDBs are identical. -p:LrmReproducible=true also drops
      PDBs (DebugType=none) and gives byte-identical binaries at any path, e.g. to compare builds across nodes.
    -->
    <ContinuousIntegrationBuild Condition="'$(CI)' == 'true' or '$(LrmReproducible)' == 'true'">true</ContinuousIntegrationBuild>
    <DebugType Condition="'$(LrmReproducible)' == 'true'">none</DebugType>
    <!-- InvariantGlobalization silently disables NFC (verified while planning); Process.init refuses that mode. -->
    <InvariantGlobalization>false</InvariantGlobalization>
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
    <IsPackable>false</IsPackable>
    <!--
      All bin/ and obj/ output goes to artifacts/<bin|obj>/<project>/<config>/ (gitignored). The path keeps the native
      separators: ContinuousIntegrationBuild maps only the native SourceRoot to /_/, so a forward-slash obj path would
      leak the clone location into every F# assembly (FSharpSignatureCompressedData) and break cross-path determinism.
    -->
    <UseArtifactsOutput>true</UseArtifactsOutput>
    <ArtifactsPath>$(MSBuildThisFileDirectory)artifacts</ArtifactsPath>
  </PropertyGroup>

  <!--
    NuGet lock files pin the whole package closure, transitive packages included (for example Mono.Cecil via Expecto).
    They live in build/locks/<project>.packages.lock.json, so a graph change touches only S0 paths. A normal restore
    updates them; CI restores in locked mode and fails when a committed lock file is stale.
  -->
  <PropertyGroup Condition="'$(LrmIsSpike)' != 'true' and '$(LrmGraphName)' != ''">
    <RestorePackagesWithLockFile>true</RestorePackagesWithLockFile>
    <NuGetLockFilePath>$(MSBuildThisFileDirectory)build/locks/$(LrmGraphName).packages.lock.json</NuGetLockFilePath>
    <RestoreLockedMode Condition="'$(CI)' == 'true'">true</RestoreLockedMode>
  </PropertyGroup>

  <!--
    The lock files carry nuget.org's content hash for FSharp.Core. The SDK also ships its own FSharp.Core nupkg in an
    implicit restore source (sdk/<version>/FSharp/library-packs), and the Linux SDK's copy hashes differently, so a
    locked restore that picks it up fails with NU1403. Every host restores from the feed the lock files were written
    against.
  -->
  <PropertyGroup>
    <DisableImplicitLibraryPacksFolder>true</DisableImplicitLibraryPacksFolder>
  </PropertyGroup>

  <!-- The default data root, for code that resolves LRM_DATA at run time (Lrm.Testing's Env, S1's LrmPaths). -->
  <ItemGroup Condition="'$(LrmGraphName)' == 'Lrm.Core' or '$(LrmGraphName)' == 'Lrm.Testing'">
    <AssemblyMetadata Include="Lrm.DefaultDataRoot" Value="$(LrmDefaultData)" />
  </ItemGroup>

  <PropertyGroup Condition="'$(LrmProjectKind)' == 'app' or '$(LrmProjectKind)' == 'test' or '$(LrmProjectKind)' == 'tool'">
    <OutputType>Exe</OutputType>
  </PropertyGroup>

  <PropertyGroup Condition="'$(LrmProjectKind)' == 'test'">
    <!-- Expecto exes are run by tools/test.ps1, not by `dotnet test`. -->
    <IsTestProject>false</IsTestProject>
    <LrmIsTestExe>true</LrmIsTestExe>
  </PropertyGroup>

  <!--
    No F# tail calls in GPU code (ADR R3-0001, D3D12ComIdiom rule 3). A call compiled with the tail. prefix frees the
    caller's frame before the callee runs, so a stack address (NativePtr.toNativeInt &&local, or a span over a local)
    passed in tail position to native code, to an Fn delegate or to another of the project's functions is read after
    its frame is gone; on the RTX 4080 this made Close return E_INVALIDARG. Tailcalls is false for every project in the
    gpu, interop or backends group of docs/project-graph.json, and for every test exe and app whose references reach
    one of those groups. Group membership comes from build/ProjectKinds.g.props (LrmGroups, LrmReaches). The root
    owns Tailcalls: a .lrm.targets file never sets it (the hygiene layering check). The cpu tier scans the IL of the
    D3D12 interop, its tests and Lrm.Gpu.Core for tail. prefixes (Lrm.Testing's TailCalls.scan).
  -->
  <PropertyGroup>
    <_LrmGpuCode>false</_LrmGpuCode>
    <_LrmGpuCode Condition="$(LrmGroups.Contains(';gpu;')) or $(LrmGroups.Contains(';interop;')) or $(LrmGroups.Contains(';backends;'))">true</_LrmGpuCode>
    <_LrmGpuCode Condition="'$(LrmProjectKind)' != 'lib' and '$(LrmProjectKind)' != 'tool' and ($(LrmReaches.Contains(';gpu;')) or $(LrmReaches.Contains(';interop;')) or $(LrmReaches.Contains(';backends;')))">true</_LrmGpuCode>
    <Tailcalls Condition="'$(_LrmGpuCode)' == 'true'">false</Tailcalls>
  </PropertyGroup>

  <PropertyGroup Condition="'$(LrmIsSpike)' == 'true'">
    <!-- Spikes are throwaway: not in the solution, not in CI, free to pin their own packages. -->
    <ManagePackageVersionsCentrally>false</ManagePackageVersionsCentrally>
  </PropertyGroup>
</Project>
